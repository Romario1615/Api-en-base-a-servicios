{
  "info": {
    "_postman_id": "042fc335-7af5-49a1-80ec-5ae12efe6d3c",
    "name": "API Biblioteca",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para el entorno de pruebas de la biblioteca. Ejecuta las cuatro carpetas en orden con Collection Runner o usa npm test. Cada corrida crea cuentas y una sala de prueba únicas. Las credenciales se generan durante la ejecución."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4318",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('corrida') || pm.info.requestName === 'Estado de la API') {",
          "  const id = pm.variables.replaceIn('{{$guid}}');",
          "  const fecha = new Date(Date.now() + 86400000).toISOString().slice(0, 10);",
          "  pm.collectionVariables.set('corrida', id);",
          "  pm.collectionVariables.set('correoA', 'lectora-' + id + '@example.test');",
          "  pm.collectionVariables.set('correoB', 'lector-' + id + '@example.test');",
          "  pm.collectionVariables.set('correoSinCuenta', 'sin-cuenta-' + id + '@example.test');",
          "  pm.collectionVariables.set('clave', 'Biblioteca-' + pm.variables.replaceIn('{{$guid}}'));",
          "  pm.collectionVariables.set('sala', 'Sala de estudio ' + id.slice(0, 8));",
          "  pm.collectionVariables.set('salaEquivalente', '  SALA   DE  ESTUDIO ' + id.slice(0, 8).toUpperCase() + '  ');",
          "  pm.collectionVariables.set('fecha', fecha);",
          "  ['sesionA', 'sesionB', 'recuperacion', 'usuarioA', 'usuarioB', 'reservaA', 'reservaB'].forEach(k => pm.collectionVariables.unset(k));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Cuenta y reserva",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('MongoDB está conectado', () => {",
                  "  pm.expect(datos.estado).to.equal('ok');",
                  "  pm.expect(datos.baseDeDatos).to.equal('conectada');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar cuenta titular",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lectora de prueba\",\n  \"email\": \"{{correoA}}\",\n  \"password\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const datos = pm.response.json();",
                  "pm.test('Devuelve un usuario público identificado', () => {",
                  "  pm.expect(datos.usuario).to.have.all.keys('id', 'nombre', 'email');",
                  "  pm.expect(datos.usuario.id).to.match(/^[a-f\\d]{24}$/i);",
                  "  pm.expect(datos.usuario.email).to.equal(pm.collectionVariables.get('correoA'));",
                  "});",
                  "pm.collectionVariables.set('usuarioA', datos.usuario.id);"
                ]
              }
            }
          ]

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "biblioteca": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/biblioteca",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource/baskervville", "output": "licencias/baskervville" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource-variable/source-sans-3", "output": "licencias/source-sans-3" },
              { "glob": "LICENSE", "input": "node_modules/lucide-static", "output": "licencias/lucide" }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "750kB" }]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json", "host": "127.0.0.1" },
          "configurations": {
            "production": { "buildTarget": "biblioteca:build:production" },
            "development": { "buildTarget": "biblioteca:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
